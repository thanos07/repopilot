DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:3000
# For production use PostgreSQL and DJANGO_DEBUG=false.
# DATABASE_URL=postgresql://repopilot:password@localhost:5432/repopilot
REDIS_URL=redis://localhost:6379/0
LIVE_EXECUTION_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# USD per million tokens; conservative peak-rate estimates, checked 2026-09-10.
AI_PRICE_INPUT=0.30
AI_PRICE_CACHED=0.006
AI_PRICE_OUTPUT=1.20
E2B_API_KEY=
E2B_TEMPLATE=
PUBLISH_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# Keep $1 of a $5 top-up in reserve. Applies to recorded usage in this database.
AI_ACCOUNT_BUDGET=4.00

# Production HTTPS settings: see docs/security-configuration.md.
# Enable proxy trust only behind a proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY_HTTPS=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
